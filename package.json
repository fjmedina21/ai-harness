{
  "name": "ai-harness",
  "private": true,
  "version": "0.8.0",
  "description": "Experimental local-first AI Harness for provider-agnostic software-engineering orchestration",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "tsc -b --pretty false",
    "test": "pnpm run build && node --test packages/*/dist/__tests__/*.test.js apps/*/dist/__tests__/*.test.js",
    "test:isolation": "pnpm run build && node packages/tools/dist/integration/isolation.js",
    "test:phase9b-podman": "pnpm run build && node packages/tools/dist/integration/phase9-validation.js",
    "test:github-auth": "pnpm run build && node --test packages/security/dist/__tests__/github-auth.test.js apps/cli/dist/__tests__/github-auth-cli.test.js apps/cli/dist/__tests__/github-operational-l2.test.js apps/cli/dist/__tests__/personal-approval-cli.test.js packages/application/dist/__tests__/personal-approval.test.js",
    "test:phase9b": "pnpm run build && node --test packages/tools/dist/__tests__/phase9-validation.test.js packages/tools/dist/__tests__/validation-transfer-process.test.js packages/tools/dist/__tests__/personal-validation.test.js",
    "test:personal-approval": "pnpm run build && node --test packages/application/dist/__tests__/personal-approval.test.js packages/tools/dist/__tests__/personal-validation.test.js apps/cli/dist/__tests__/personal-approval-cli.test.js",
    "bench:engineering": "pnpm run build && node packages/application/dist/engineering-benchmark.js",
    "smoke:engineering-openai": "pnpm run build && node apps/cli/dist/engineering-provider-smoke.js",
    "smoke:real-provider": "pnpm run build && node apps/cli/dist/real-provider-smoke.js",
    "smoke:github-auth": "pnpm run build && node apps/cli/dist/github-auth-smoke.js",
    "harness": "node apps/cli/dist/index.js",
    "dev": "pnpm run build && pnpm harness --help"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3"
  }
}
